# TOP SECRET AI - local configuration
# Replace the placeholders below with your own API keys.
# NEVER share or commit real API keys.

# Google Gemini
GEMINI_API_KEY=

# OpenAI / GPT
OPENAI_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# SAIT settings
SAIT_MODEL=
SAIT_WORKSPACE=workspace

# Optional: comma-separated fallback provider order
SAIT_PROVIDER_ORDER=gemini,openai,anthropic,groq,openrouter

# Copy this file to .env on your PC.
# NEVER commit the real keys to GitHub.

# AI providers. At least one key is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides.
GEMINI_MODEL=
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-5.6
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openrouter/free

# Provider order used by /auto. Put your preferred free/reliable provider first.
SAIT_PROVIDER_ORDER=gemini,anthropic,openai,groq,openrouter
SAIT_WORKSPACE=workspace

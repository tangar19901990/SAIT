# Copy this file to .env on your PC. NEVER commit the real key.
OPENAI_API_KEY=
# OpenRouter example:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
SAIT_MODEL=openrouter/free
# Optional: comma-separated backup models. These are used for transient/model errors.
# NOTE: switching free models does NOT bypass OpenRouter's account-wide daily free quota.
SAIT_FALLBACK_MODELS=
SAIT_WORKSPACE=workspace
